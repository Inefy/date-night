# Supabase public client config. The publishable key is safe in client builds only when RLS is enforced.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon keys are still accepted by the app as a fallback during migration.
# Never add service role keys, secret keys, or other privileged credentials to Expo client env files.
