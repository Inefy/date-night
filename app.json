{
  "expo": {
    "name": "Date Night Deck",
    "slug": "date-night-deck",
    "version": "1.0.0",
    "scheme": "datenightdeck",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7ED"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.inefy.datenightdeck",
      "associatedDomains": [
        "applinks:datenightdeck.app"
      ],
      "supportsTablet": true
    },
    "android": {
      "package": "com.inefy.datenightdeck",
      "adaptiveIcon": {
        "backgroundColor": "#FFF7ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "host": "datenightdeck.app",
              "pathPrefix": "/mystery",
              "scheme": "https"
            }
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "Date Night Deck needs calendar access to add your planned date.",
          "remindersPermission": false
        }
      ]
    ]
  }
}
